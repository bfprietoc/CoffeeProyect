PORT=8080
DATABASE_URL=postgres://coffee:coffee@localhost:5432/coffeedb?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-to-a-random-secret-in-production

# API key para endpoints /admin/* (si falta, quedan deshabilitados)
ADMIN_API_KEY=secret123

# SMTP para notificaciones por email (si falta SMTP_HOST, emails deshabilitados)
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=

# Pagos con Wompi (Web Checkout) — si falta cualquiera de las 4, los pagos
# quedan deshabilitados (POST /orders/{id}/payment → 503, webhook → 503).
# Dejar este archivo vacío es válido para dev/CI: el flujo de pagos no se muestra.
# Las llaves de sandbox (pub_test_…) son gratis en wompi.com; producción las
# obtén al activar la cuenta.
WOMPI_PUBLIC_KEY=pub_test_xxx
# Secreto de integridad (Dashboard → Desarrolladores → Secretos para
# integración técnica). NUNCA exponer al frontend: solo se usa server-side.
WOMPI_INTEGRITY_SECRET=prod_integrity_xxx
# Secreto de eventos (mismo panel, secreto distinto al de integridad).
WOMPI_EVENT_SECRET=prod_events_xxx
# URL pública del sitio (para armar redirect_url; p. ej. https://shop.example.com)
PUBLIC_BASE_URL=http://localhost:3001
